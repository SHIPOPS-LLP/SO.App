{
    "$schema": "https://schema.railpack.com",
    "variables": {
        "NODE_ENV": "production",
        "PORT": "3000",
        "HOSTNAME": "0.0.0.0"
    },
    "steps": {
        "setup": {
            "nixPkgs": [
                "nodejs_18"
            ]
        },
        "install": {
            "inputs": [
                "setup"
            ],
            "commands": [
                "npm ci --omit=dev"
            ]
        },
        "build": {
            "inputs": [
                "install"
            ],
            "commands": [
                "npm run build"
            ]
        }
    },
    "deploy": {
        "startCommand": "npm run start"
    }
}